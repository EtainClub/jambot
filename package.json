{
  "name": "insta-factbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "grant-member": "tsx --env-file=.env.local scripts/grant-member.mts",
    "smoke": "node --conditions=react-server --env-file=.env.local --import tsx scripts/smoke-judge.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.17.1"
}
